# Copy to .env for local deploy scripts. Never commit .env.
# Values below are names only, except the shared environment id (not a credential).

# Shared CloudBase environment (Shanghai). Other apps use the same env.
# Deploy scripts refuse to run unless this is set. Do not create unprefixed resources.
TCB_ENV_ID=english-little-steps-d0a2b84764b

# Server credentials. Create a least-privilege CAM user. Leave empty in git.
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# Custom-login private key (PEM contents or a path). Required only for WeChat ticket sign-in.
TCB_CUSTOM_LOGIN_PRIVATE_KEY=

# HMAC pepper for invite codes and WeChat bind codes. Required in production.
INVITE_CODE_PEPPER=

# WeChat mini program (reserved; not used in week 1).
WECHAT_APPID=
WECHAT_APPSECRET=

# Set to cloudbase only on a deployed function. Local tests use the in-memory store.
HST_DATA_BACKEND=

# Local dev server only. Cloud functions ignore these.
DEV_AUTH=
DEV_API_PORT=8787
